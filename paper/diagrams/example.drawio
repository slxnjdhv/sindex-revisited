<mxfile host="drawio"><diagram id="example" name="example"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Q: How many herbs and spices make up the secret blend of KFC&amp;#39;s Original Recipe? &amp;nbsp; Reference answer: &lt;b&gt;11&lt;/b&gt; &amp;nbsp; Most-likely answer: &lt;b&gt;30&lt;/b&gt; (wrong)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#9a9993;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="860" height="46" as="geometry"/></mxCell><mxCell id="c4" value="Embedding only (SINdex): 1 cluster" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;dashed=1;fillColor=none;strokeColor=#9a9993;fontFamily=Helvetica;fontSize=11;fontColor=#52514e;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="380" height="230" as="geometry"/></mxCell><mxCell id="c5" value="30&lt;br&gt;30 herbs and spices.&lt;br&gt;30 herbs and spices.&lt;br&gt;30 herbs and spices.&lt;br&gt;30 herbs and spices.&lt;br&gt;33 herbs and spices.&lt;br&gt;33 herbs and spices.&lt;br&gt;33 herbs and spices.&lt;br&gt;The secret blend contains 11 herbs and spices.&lt;br&gt;The secret blend contains 11 herbs and spices." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;strokeWidth=1.5;fillColor=#f5f5f3;strokeColor=#52514e;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="15" y="100" width="350" height="150" as="geometry"/></mxCell><mxCell id="c6" value="SINdex = 0.016 (looks confident; 37th percentile)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#0b0b0b;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15" y="260" width="360" height=